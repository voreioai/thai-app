# No configuration is required — the app runs with bundled content and stores
# progress in the browser. These two are optional.

# Polite particle: "female" keeps ค่ะ/คะ (default), "male" switches to ครับ in the UI.
NEXT_PUBLIC_USER_GENDER=female

# Shown in a couple of places; optional.
NEXT_PUBLIC_USER_NAME=
